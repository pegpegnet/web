---
import Base from '../layouts/Base.astro';
import HeroScene from '../components/HeroScene.astro';
import { t, path, locales, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const alternates = Object.fromEntries(locales.map((l) => [l, path(l)])) as Record<Locale, string>;
const titles: Record<Locale, string> = {
  es: 'Desarrollo apps Barcelona | PegPeg',
  en: 'App development Barcelona | PegPeg',
  ca: "Desenvolupament d'apps Barcelona | PegPeg",
};
---
<Base locale={locale} title={titles[locale]} description={t(locale, 'ui-hero-sub')} alternates={alternates}>
  <section class="hero" aria-labelledby="hero-title">
    <HeroScene />
    <div class="container hero-text">
      <p class="eyebrow" data-reveal="up" data-reveal-now>PegPeg — Barcelona</p>
      <h1 id="hero-title" data-reveal="lines" data-reveal-now>{t(locale, 'ui-tagline')}</h1>
      <p class="sub" data-reveal="up" data-reveal-now>{t(locale, 'ui-hero-sub')}</p>
    </div>
  </section>

  <section class="intro container" aria-labelledby="intro-title">
    <p class="eyebrow" data-reveal="up">{t(locale, 'ui-studio')}</p>
    <h2 id="intro-title" class="statement" data-reveal="lines">{t(locale, 'weare')}</h2>
    <p class="statement-sub" data-reveal="up">{t(locale, 'weare2')}</p>
  </section>
</Base>

<style>
  .hero {
    position: relative;
    min-height: calc(100svh - 4.25rem);
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
  }
  .hero :global(.hero-scene) {
    inset: 0 0 auto 0;
    height: 56%;
  }
  .hero-text {
    position: relative;
    padding-bottom: var(--space-xl);
  }
  h1 {
    margin-top: var(--space-m);
    font-size: var(--step-5);
    font-weight: 650;
    letter-spacing: -0.045em;
    line-height: 0.92;
    max-width: 12ch;
  }
  .sub {
    margin-top: var(--space-l);
    max-width: 38ch;
    font-size: var(--step-1);
    line-height: 1.4;
    color: var(--muted);
  }
  .intro {
    padding-block: var(--space-2xl) var(--space-xl);
  }
  .statement {
    margin-top: var(--space-m);
    max-width: 22ch;
    font-size: var(--step-4);
    font-weight: 600;
    letter-spacing: -0.035em;
    line-height: 1.02;
  }
  .statement-sub {
    margin-top: var(--space-l);
    max-width: 44ch;
    font-size: var(--step-1);
    line-height: 1.45;
    color: var(--muted);
  }
  @media (min-width: 52rem) {
    .intro {
      display: grid;
      grid-template-columns: 1fr 2fr;
      column-gap: var(--gutter);
    }
    .intro .eyebrow {
      grid-row: 1 / span 2;
      margin-top: 0.9rem;
    }
    .statement,
    .statement-sub {
      grid-column: 2;
    }
    .hero :global(.hero-scene) {
      inset: 0 0 0 auto;
      width: 60%;
      height: 100%;
    }
    h1 {
      font-size: clamp(3.4rem, 1.2rem + 6vw, 8rem);
      max-width: 9ch;
    }
  }
</style>
