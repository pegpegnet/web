---
// Container for the 3D hero, the scene code (three.js) is fetched only after the page has
// loaded and the browser is idle, so it never delays first paint. If WebGL is unavailable or
// the visitor has Save-Data on, nothing loads and the hero stays typographic.
import { getImage } from 'astro:assets';
import yutub from '../assets/works/yutub-capture.jpg';
import tv3 from '../assets/works/tv3-capture.png';
import sumo from '../assets/works/sumo-capture.png';
import bot from '../assets/works/telegram-bot.png';

// Keep the source pixel size: the scene crops screens by pixel coordinates.
const textures = Object.fromEntries(
  await Promise.all(
    Object.entries({ yutub, tv3, sumo, bot }).map(async ([name, src]) => [
      name,
      (await getImage({ src, format: 'webp', quality: 88, width: src.width })).src,
    ]),
  ),
);
---
<div class="hero-scene" data-hero-scene data-textures={JSON.stringify(textures)}></div>

<script>
  function supportsWebGL() {
    try {
      return !!document.createElement('canvas').getContext('webgl2');
    } catch {
      return false;
    }
  }

  const el = document.querySelector<HTMLElement>('[data-hero-scene]');
  const saveData = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection?.saveData;

  if (el && supportsWebGL() && !saveData) {
    const start = () =>
      import('../scripts/hero-scene').then(({ mountHeroScene }) =>
        mountHeroScene(el, JSON.parse(el.dataset.textures!)),
      );
    const idle = () => ('requestIdleCallback' in window ? requestIdleCallback(start, { timeout: 1500 }) : setTimeout(start, 200));
    if (document.readyState === 'complete') idle();
    else addEventListener('load', idle, { once: true });
  }
</script>

<style>
  .hero-scene {
    position: absolute;
    pointer-events: none;
    opacity: 0;
    transition: opacity 900ms var(--ease-out);
  }
  .hero-scene[data-ready] {
    opacity: 1;
  }
  .hero-scene :global(canvas) {
    width: 100%;
    height: 100%;
  }
</style>
