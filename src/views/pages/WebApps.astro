---
import Base from '../../layouts/Base.astro';
import Section from '../../components/Section.astro';
import { t, alternatesFor, type Locale, type MessageKey } from '../../i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const advantages: MessageKey[] = ['webapps-flutter-advantage', 'webapps-react-advantage', 'webapps-xamarin-advantage', 'webapps-pwa-advantage'];
---
<Base
  locale={locale}
  title={t(locale, 'meta_cross_platform_title')}
  description={t(locale, 'meta_cross_platform_description')}
  alternates={alternatesFor('webApps')}
  current="services"
>
  <header class="page-head container">
    <h1>{t(locale, 'webapps-title')}</h1>
    <p class="lead">{t(locale, 'webapps-development-title')}</p>
  </header>

  <Section title={t(locale, 'webapps-phonegap-title')} id="flutter">
    <p>{t(locale, 'webapps-description-1')}</p>
  </Section>
  <Section title={t(locale, 'webapps-react-title')} id="react-native">
    <p>{t(locale, 'webapps-description-2')}</p>
  </Section>
  <Section title={t(locale, 'webapps-xamarin-title')} id="kmp">
    <p>{t(locale, 'webapps-xamarin-description')}</p>
  </Section>
  <Section title={t(locale, 'webapps-mobile-title')} id="mobile-web">
    <p>{t(locale, 'webapps-description-3')}</p>
  </Section>
  <Section title={t(locale, 'webapps-choosing-title')} id="choosing">
    <p>{t(locale, 'webapps-choosing-description')}</p>
    <ul>{advantages.map((k) => <li>{t(locale, k)}</li>)}</ul>
  </Section>
</Base>
