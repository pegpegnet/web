---
// Home page work reel. With motion on wide screens the section pins and the row of work
// travels sideways as you scroll; otherwise it is a plain horizontally scrollable, snapping row.
import WorkCard from './WorkCard.astro';
import { t, path, type Locale } from '../i18n';
import { projects } from '../data/projects';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const featured = [
  'app-visionos-yutub',
  'telegram-bot-instagram-preview',
  'app-iphone-tv3',
  'app-iphone-pong',
  'app-iphone-futbol-club-barcelona-zigazaga',
  'youtube-mix-videos',
  'cruzcampo',
  'tmb',
].map((slug) => projects.find((p) => p.slug === slug)!);
---
<section class="reel" aria-labelledby="reel-title" data-reel>
  <div class="container head">
    <h2 id="reel-title">{t(locale, 'ui-selected-work')}</h2>
    <a class="button quiet" href={path(locale, 'projects')}>{t(locale, 'ui-all-projects')}</a>
  </div>
  <div class="viewport">
    <ul class="track" data-track>
      {
        featured.map((project) => (
          <li>
            <WorkCard locale={locale} project={project} sizes="(min-width: 52rem) 34vw, 82vw" />
          </li>
        ))
      }
    </ul>
  </div>
  <div class="container"><div class="progress" aria-hidden="true"><span data-progress></span></div></div>
</section>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  const section = document.querySelector<HTMLElement>('[data-reel]');
  const track = section?.querySelector<HTMLElement>('[data-track]');
  const bar = section?.querySelector<HTMLElement>('[data-progress]');

  if (section && track && bar && document.documentElement.classList.contains('motion')) {
    const mm = gsap.matchMedia();
    mm.add('(min-width: 52rem)', () => {
      section.classList.add('pinned');
      const distance = () => track.scrollWidth - document.documentElement.clientWidth;

      const travel = gsap.to(track, {
        x: () => -distance(),
        ease: 'none',
        scrollTrigger: {
          trigger: section,
          start: 'top top',
          end: () => `+=${distance()}`,
          pin: true,
          scrub: 0.6,
          invalidateOnRefresh: true,
          onUpdate: (self) => gsap.set(bar, { scaleX: self.progress }),
        },
      });

      // Each picture drifts against the travel and cards settle in from a slight tilt as they enter.
      for (const card of track.querySelectorAll<HTMLElement>('li')) {
        const img = card.querySelector('img');
        if (img) {
          gsap.fromTo(
            img,
            { xPercent: -8, scale: 1.18 },
            {
              xPercent: 8,
              ease: 'none',
              scrollTrigger: { trigger: card, containerAnimation: travel, start: 'left right', end: 'right left', scrub: true },
            },
          );
        }
        gsap.from(card, {
          rotate: 4,
          yPercent: 12,
          transformOrigin: '0% 100%',
          ease: 'power3.out',
          scrollTrigger: { trigger: card, containerAnimation: travel, start: 'left 100%', end: 'left 60%', scrub: true },
        });
      }

      return () => section.classList.remove('pinned');
    });
  }
</script>

<style>
  .reel {
    padding-block: var(--space-xl);
    overflow: hidden;
  }
  .head {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: var(--space-s);
    margin-bottom: var(--space-l);
  }
  h2 {
    font-size: var(--step-4);
    letter-spacing: -0.04em;
    max-width: 14ch;
  }
  .viewport {
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }
  .viewport::-webkit-scrollbar {
    display: none;
  }
  .track {
    display: flex;
    gap: var(--gutter);
    width: max-content;
    list-style: none;
    margin: 0;
    padding: 0 var(--gutter);
  }
  .track li {
    width: min(82vw, 30rem);
    scroll-snap-align: start;
    scroll-margin-left: var(--gutter);
  }
  .progress {
    display: none;
    height: 2px;
    margin-top: var(--space-l);
    background: var(--line);
  }
  .progress span {
    display: block;
    height: 100%;
    background: var(--blue);
    transform: scaleX(0);
    transform-origin: 0 50%;
  }
  @media (min-width: 52rem) {
    .track {
      padding-left: max(var(--gutter), calc((100vw - var(--max)) / 2 + var(--gutter)));
    }
    .track li {
      width: clamp(24rem, 34vw, 34rem);
    }
    .reel:global(.pinned) {
      min-height: 100svh;
      display: flex;
      flex-direction: column;
      justify-content: center;
    }
    .reel:global(.pinned) .viewport {
      overflow: visible;
    }
    .reel:global(.pinned) .progress {
      display: block;
    }
  }
</style>
