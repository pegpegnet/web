---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { t, path, alternatesFor, type Locale } from '../i18n';
import { projects, listedProjects, type Project } from '../data/projects';
import { maybeCover, workImage, transitionName } from '../data/media';

interface Props {
  locale: Locale;
  project: Project;
}
const { locale, project } = Astro.props;

const name = 'key' in project.title ? t(locale, project.title.key) : project.title.text;
const heading = project.page ? t(locale, project.page.titleKey) : name;
const summary = t(locale, project.summaryKey);
const plainSummary = summary.replace(/<[^>]+>/g, '');
const kinds = project.categories.map((c) => t(locale, c === 'app' ? 'apps' : c === 'web' ? 'web' : 'games')).join(', ');
const hero = maybeCover(project);
// Pictures after the first one: the rest of the gallery for projects without a written case study.
const gallery = (project.gallery ?? []).slice(project.page ? 0 : 1);

// Next listed project, wrapping round, so a visitor can keep browsing the work.
const order = listedProjects.length ? listedProjects : projects;
const next = order[(order.findIndex((p) => p.slug === project.slug) + 1) % order.length];
const nextName = 'key' in next.title ? t(locale, next.title.key) : next.title.text;
const nextCover = maybeCover(next);
---
<Base
  locale={locale}
  title={`${name} | PegPeg`}
  description={plainSummary}
  alternates={alternatesFor('projects', project.slug)}
  current="projects"
>
  <article>
    <header class="page-head container">
      <p class="crumb"><a href={path(locale, 'projects')}>{t(locale, 'projects')}</a></p>
      <h1 data-reveal="lines" data-reveal-now>{heading}</h1>
      <p class="lead">{plainSummary}</p>
      <p class="kinds">{kinds}{project.year && `, ${project.year}`}</p>
    </header>

    {
      hero && (
        <div class="container">
          <div class="hero" style={`view-transition-name:${transitionName(project)}`}>
            <Image src={hero} alt="" widths={[640, 960, 1440]} sizes="(min-width: 88rem) 84rem, 100vw" loading="eager" fetchpriority="high" />
          </div>
        </div>
      )
    }

    {
      project.page && (
        <div class="container story">
          <div class="body">
            {project.page.blocks.map((block) => {
              switch (block.type) {
                case 'h2':
                  return <h2 set:html={t(locale, block.key)} />;
                case 'h3':
                  return <h3 set:html={t(locale, block.key)} />;
                case 'p':
                  return <p set:html={t(locale, block.key)} />;
                case 'list':
                  return (
                    <ul>
                      {block.keys.map((k) => (
                        <li set:html={t(locale, k)} />
                      ))}
                    </ul>
                  );
                case 'image':
                  return (
                    <figure class="shot">
                      <Image src={workImage(block.src)} alt={block.alt} widths={[480, 960]} sizes="(min-width: 52rem) 48rem, 100vw" />
                    </figure>
                  );
                case 'video':
                  return (
                    <div class="video">
                      <iframe
                        src={`https://www.youtube-nocookie.com/embed/${block.youtube}`}
                        title={t(locale, block.titleKey)}
                        loading="lazy"
                        allow="encrypted-media; picture-in-picture; fullscreen"
                        referrerpolicy="strict-origin-when-cross-origin"
                      />
                    </div>
                  );
                case 'link':
                  return (
                    <p>
                      <a class="button" href={block.href} rel="external">
                        {t(locale, block.key)}
                      </a>
                    </p>
                  );
                case 'press':
                  return (
                    <ul class="press" aria-label={t(locale, 'ui-press')}>
                      {block.items.map((item) => (
                        <li>
                          <a href={item.href} rel="external">
                            {item.name}
                          </a>
                        </li>
                      ))}
                    </ul>
                  );
              }
            })}
          </div>
        </div>
      )
    }

    {
      gallery.length > 0 && (
        <div class="container gallery">
          {gallery.map((src) => (
            <figure class="shot">
              <Image src={workImage(src)} alt={name} widths={[480, 960]} sizes="(min-width: 52rem) 50vw, 100vw" />
            </figure>
          ))}
        </div>
      )
    }
  </article>

  <nav class="next container" aria-label={t(locale, 'ui-next-project')}>
    <a href={path(locale, 'projects', next.slug)}>
      <span class="next-label">{t(locale, 'ui-next-project')}</span>
      <span class="next-name">{nextName}</span>
      {
        nextCover && (
          <span class="next-media" style={`view-transition-name:${transitionName(next)}`}>
            <Image src={nextCover} alt="" widths={[400, 640]} sizes="20rem" />
          </span>
        )
      }
    </a>
  </nav>
</Base>

<style>
  .crumb {
    margin-bottom: var(--space-s);
    font-weight: 600;
  }
  .crumb a {
    text-decoration: none;
    color: var(--mist);
  }
  .crumb a:hover {
    color: var(--blue);
  }
  .page-head h1 {
    max-width: 18ch;
    font-size: var(--step-4);
  }
  .kinds {
    margin-top: var(--space-s);
    color: var(--mist);
    font-size: var(--step--1);
  }
  .hero {
    overflow: hidden;
    border-radius: var(--radius-l);
    background: var(--surface);
    aspect-ratio: 16 / 9;
    max-height: 72svh;
    width: 100%;
  }
  .hero :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .story {
    padding-block: var(--space-xl) 0;
  }
  .body {
    max-width: 64ch;
  }
  .body > :global(* + *) {
    margin-top: 1.1em;
  }
  .body :global(h2) {
    margin-top: 2.2em;
    font-size: var(--step-2);
  }
  .body > :global(h2:first-child) {
    margin-top: 0;
  }
  .body :global(ul) {
    padding-left: 1.2em;
  }
  .body :global(li + li) {
    margin-top: 0.35em;
  }
  .body :global(p a:not(.button)) {
    color: var(--blue);
  }
  .shot {
    margin: 0;
    overflow: hidden;
    border-radius: var(--radius-s);
    background: var(--surface);
  }
  .body .shot,
  .body .video {
    margin-block: 2em;
  }
  .shot :global(img) {
    width: 100%;
  }
  .video {
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: var(--radius-s);
    background: var(--ink);
  }
  .video iframe {
    width: 100%;
    height: 100%;
    border: 0;
  }
  .press {
    list-style: none;
    padding: 0 !important;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs) var(--space-m);
    font-weight: 600;
  }
  .gallery {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr));
    gap: var(--gutter);
    padding-top: var(--gutter);
  }
  .next {
    margin-top: var(--space-2xl);
  }
  .next a {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: var(--space-2xs) var(--gutter);
    padding-top: var(--space-l);
    border-top: 1px solid var(--line);
    text-decoration: none;
  }
  .next-label {
    grid-column: 1;
    color: var(--mist);
    font-weight: 600;
  }
  .next-name {
    grid-column: 1;
    font-family: var(--font-display);
    font-size: var(--step-4);
    font-weight: 650;
    letter-spacing: -0.04em;
    line-height: 1;
    transition: color var(--dur-2) var(--ease-out);
  }
  .next a:hover .next-name {
    color: var(--blue);
  }
  .next-media {
    grid-column: 2;
    grid-row: 1 / span 2;
    width: clamp(7rem, 22vw, 20rem);
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: var(--radius-l);
    transition: transform var(--dur-3) var(--ease-out);
  }
  .next a:hover .next-media {
    transform: rotate(-2deg) scale(1.03);
  }
  .next-media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>
