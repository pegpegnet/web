---
// Case-study pages at the previous site's URLs: /es/proyectos/<slug>/, /en/projects/<slug>/, /ca/projectes/<slug>/.
import ProjectPage from '../../../views/ProjectPage.astro';
import { locales, segments, type Locale } from '../../../i18n';
import { projects } from '../../../data/projects';

export function getStaticPaths() {
  return locales.flatMap((locale) =>
    projects.map((project) => ({
      params: { locale, projects: segments.projects[locale], slug: project.slug },
      props: { slug: project.slug },
    })),
  );
}
const locale = Astro.params.locale as Locale;
const project = projects.find((p) => p.slug === Astro.props.slug)!;
---
<ProjectPage locale={locale} project={project} />
