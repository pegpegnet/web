---
import Wordmark from './Wordmark.astro';
import LangSwitch from './LangSwitch.astro';
import { t, path, type Locale, type Section } from '../i18n';

interface Props {
  locale: Locale;
  alternates: Record<Locale, string>;
  current?: Section;
}
const { locale, alternates, current } = Astro.props;
const items: { section: Section; label: string }[] = [
  { section: 'projects', label: t(locale, 'projects') },
  { section: 'services', label: t(locale, 'services') },
  { section: 'ai', label: t(locale, 'ai-solutions') },
  { section: 'contact', label: t(locale, 'contact') },
];
---
<header class="site-header" data-header>
  <div class="container bar">
    <Wordmark href={path(locale)} />
    <nav class="nav" id="site-nav" aria-label={t(locale, 'ui-main-nav')} data-nav>
      <ul>
        {
          items.map((item, i) => (
            <li style={`--i:${i}`}>
              <a href={path(locale, item.section)} aria-current={item.section === current ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
      <LangSwitch locale={locale} alternates={alternates} label={t(locale, 'language')} />
    </nav>
    <button
      class="menu-button"
      type="button"
      aria-expanded="false"
      aria-controls="site-nav"
      data-menu-button
      data-open-label={t(locale, 'ui-menu')}
      data-close-label={t(locale, 'ui-close')}
    >
      <span class="menu-label">{t(locale, 'ui-menu')}</span>
      <span class="menu-icon" aria-hidden="true"></span>
    </button>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]')!;
  const button = header.querySelector<HTMLButtonElement>('[data-menu-button]')!;
  const label = button.querySelector('.menu-label')!;

  function setOpen(open: boolean) {
    header.toggleAttribute('data-open', open);
    button.setAttribute('aria-expanded', String(open));
    label.textContent = open ? button.dataset.closeLabel! : button.dataset.openLabel!;
    document.documentElement.style.overflow = open ? 'hidden' : '';
  }

  button.addEventListener('click', () => setOpen(!header.hasAttribute('data-open')));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && header.hasAttribute('data-open')) {
      setOpen(false);
      button.focus();
    }
  });
  matchMedia('(min-width: 52rem)').addEventListener('change', () => setOpen(false));

  // Hide the bar while scrolling down, bring it back on the way up.
  let last = scrollY;
  addEventListener(
    'scroll',
    () => {
      const y = scrollY;
      header.toggleAttribute('data-scrolled', y > 8);
      if (!header.hasAttribute('data-open')) header.toggleAttribute('data-hidden', y > last && y > 240);
      last = y;
    },
    { passive: true },
  );
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    transition:
      transform var(--dur-2) var(--ease-out),
      background-color var(--dur-2) var(--ease-out),
      border-color var(--dur-2) var(--ease-out);
    border-bottom: 1px solid transparent;
  }
  .site-header[data-scrolled] {
    background: color-mix(in srgb, var(--paper) 82%, transparent);
    backdrop-filter: saturate(1.4) blur(14px);
    -webkit-backdrop-filter: saturate(1.4) blur(14px);
    border-bottom-color: var(--line);
  }
  .site-header[data-hidden] {
    transform: translateY(-100%);
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-m);
    height: 4.25rem;
  }
  .nav {
    display: flex;
    align-items: center;
    gap: var(--space-l);
  }
  .nav ul {
    display: flex;
    gap: var(--space-m);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .nav > ul a {
    position: relative;
    text-decoration: none;
    font-size: 0.95rem;
    font-weight: 500;
  }
  /* Underline draws from the left on hover and stays for the current page */
  .nav > ul a::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -0.3rem;
    height: 1px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: right;
    transition: transform var(--dur-2) var(--ease-out);
  }
  .nav > ul a:hover::after,
  .nav > ul a[aria-current]::after {
    transform: scaleX(1);
    transform-origin: left;
  }
  .menu-button {
    display: none;
  }
  /* The wordmark stays above the open mobile menu */
  .bar > :global(.wordmark) {
    position: relative;
    z-index: 2;
  }

  @media (max-width: 51.99rem) {
    .menu-button {
      display: inline-flex;
      align-items: center;
      gap: 0.6rem;
      padding: 0.5rem 0;
      background: none;
      border: 0;
      cursor: pointer;
      font-family: var(--font-body);
    font-weight: 600;
      font-size: var(--step--1);
      position: relative;
      z-index: 2;
    }
    .menu-icon,
    .menu-icon::before {
      display: block;
      width: 1.25rem;
      height: 1.5px;
      background: currentColor;
      transition: transform var(--dur-2) var(--ease-out);
    }
    .menu-icon {
      position: relative;
      transform: translateY(-3px);
    }
    .menu-icon::before {
      content: '';
      position: absolute;
      top: 6px;
    }
    [data-open] .menu-icon {
      transform: translateY(0) rotate(45deg);
    }
    [data-open] .menu-icon::before {
      transform: translateY(-6px) rotate(-90deg);
    }
    .nav {
      position: fixed;
      inset: 0;
      z-index: 1;
      flex-direction: column;
      align-items: flex-start;
      justify-content: space-between;
      padding: 6rem var(--gutter) var(--space-l);
      background: var(--paper);
      visibility: hidden;
      clip-path: inset(0 0 100% 0);
      transition:
        clip-path var(--dur-3) var(--ease-in-out),
        visibility 0s linear var(--dur-3);
    }
    [data-open] .nav {
      visibility: visible;
      clip-path: inset(0 0 0 0);
      transition:
        clip-path var(--dur-3) var(--ease-in-out),
        visibility 0s;
    }
    .nav > ul {
      flex-direction: column;
      gap: var(--space-xs);
    }
    .nav > ul a {
      font-family: var(--font-display);
      font-size: var(--step-4);
      font-weight: 600;
      letter-spacing: -0.03em;
      line-height: 1.05;
    }
    .nav > ul a::after {
      display: none;
    }
    /* Links rise in one after another when the menu opens */
    .nav > ul li {
      opacity: 0;
      transform: translateY(1.5rem);
      transition:
        opacity var(--dur-2) var(--ease-out),
        transform var(--dur-3) var(--ease-out);
    }
    [data-open] .nav > ul li {
      opacity: 1;
      transform: none;
      transition-delay: calc(200ms + var(--i) * 60ms);
    }
  }
</style>
