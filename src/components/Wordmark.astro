---
// The PegPeg wordmark: the original lowercase "pegpeg" in the logo's blue, redrawn flat and heavy.
// Set in type (Funnel Display) so it stays sharp at every size.
interface Props {
  href: string;
  size?: 'small' | 'large';
}
const { href, size = 'small' } = Astro.props;
---
<a class:list={['wordmark', size]} href={href} aria-label="PegPeg">
  <span aria-hidden="true">pegpeg</span>
</a>

<style>
  .wordmark {
    display: inline-block;
    font-family: var(--font-display);
    font-weight: 800;
    letter-spacing: -0.055em;
    line-height: 1;
    color: var(--blue);
    text-decoration: none;
    transition: color var(--dur-2) var(--ease-out);
  }
  .small {
    font-size: 1.6rem;
  }
  .large {
    font-size: var(--step-4);
  }
  .wordmark:hover {
    color: var(--ink);
  }
</style>
