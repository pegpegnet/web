---
import Wordmark from './Wordmark.astro';
import { t, path, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="container">
    <a class="cta" href={path(locale, 'contact')}>
      <span class="cta-text">{t(locale, 'ui-start-project')}</span>
    </a>
    <div class="cols">
      <div class="about">
        <Wordmark href={path(locale)} />
        <p>{t(locale, 'footer')}</p>
      </div>
      <div class="col">
        <h2>{t(locale, 'address')}</h2>
        <address>Calle de Luis Antúnez&nbsp;6<br />08006 Barcelona</address>
      </div>
      <div class="col">
        <h2>{t(locale, 'ui-studio')}</h2>
        <ul>
          <li><a href={path(locale, 'projects')}>{t(locale, 'projects')}</a></li>
          <li><a href={path(locale, 'services')}>{t(locale, 'services')}</a></li>
          <li><a href={path(locale, 'glossary')}>{t(locale, 'glossary')}</a></li>
        </ul>
      </div>
      <div class="col">
        <h2>{t(locale, 'ui-follow')}</h2>
        <ul>
          <li><a href="https://www.linkedin.com/company/pegpeg" rel="me external">LinkedIn</a></li>
          <li><a href="https://x.com/pegpegnet" rel="me external">X</a></li>
          <li><a href="https://github.com/pegpegnet" rel="me external">GitHub</a></li>
        </ul>
      </div>
    </div>
    <p class="legal">© {year} PegPeg, Barcelona</p>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: var(--space-2xl);
    padding-block: var(--space-xl) var(--space-l);
    background: var(--surface);
  }
  .cta {
    display: inline-block;
    text-decoration: none;
    padding-bottom: var(--space-xl);
  }
  .cta-text {
    font-family: var(--font-display);
    font-size: var(--step-5);
    font-weight: 650;
    letter-spacing: -0.045em;
    line-height: 0.95;
    background-image: linear-gradient(currentColor, currentColor);
    background-size: 0% 0.06em;
    background-position: 0 100%;
    background-repeat: no-repeat;
    transition:
      background-size var(--dur-3) var(--ease-out),
      color var(--dur-2) var(--ease-out);
  }
  .cta:hover .cta-text {
    color: var(--blue);
    background-size: 100% 0.06em;
  }
  .cols {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-l) var(--gutter);
    padding-top: var(--space-l);
    border-top: 1px solid var(--line);
  }
  .about {
    grid-column: 1 / -1;
  }
  .about p {
    margin-top: var(--space-s);
    max-width: 46ch;
    color: var(--mist);
  }
  .col h2 {
    font-family: var(--font-body);
    font-size: var(--step--1);
    font-weight: 600;
    letter-spacing: 0;
    color: var(--mist);
  }
  .col ul {
    list-style: none;
    margin-top: var(--space-xs);
    padding: 0;
  }
  .col a {
    text-decoration: none;
  }
  address {
    margin-top: var(--space-xs);
    font-style: normal;
  }
  .legal {
    margin-top: var(--space-xl);
    font-size: var(--step--1);
    color: var(--mist);
  }
  @media (min-width: 52rem) {
    .cols {
      grid-template-columns: 2fr repeat(3, minmax(0, 1fr));
    }
    .about {
      grid-column: auto;
    }
  }
</style>
