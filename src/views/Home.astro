---
import Base from '../layouts/Base.astro';
import HeroScene from '../components/HeroScene.astro';
import { t, path, locales, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const alternates = Object.fromEntries(locales.map((l) => [l, path(l)])) as Record<Locale, string>;
const titles: Record<Locale, string> = {
  es: 'Desarrollo apps Barcelona | PegPeg',
  en: 'App development Barcelona | PegPeg',
  ca: "Desenvolupament d'apps Barcelona | PegPeg",
};
---
<Base locale={locale} title={titles[locale]} description={t(locale, 'ui-hero-sub')} alternates={alternates}>
  <section class="hero" aria-labelledby="hero-title">
    <HeroScene />
    <div class="container hero-text">
      <h1 id="hero-title" data-reveal="lines" data-reveal-now>{t(locale, 'ui-tagline')}</h1>
      <p class="lead" data-reveal="up" data-reveal-now>{t(locale, 'ui-hero-sub')}</p>
      <div class="actions" data-reveal="up" data-reveal-now>
        <a class="button" href={path(locale, 'projects')}>{t(locale, 'ui-see-work')}</a>
        <a class="button quiet" href={path(locale, 'contact')}>{t(locale, 'contact-us')}</a>
      </div>
    </div>
  </section>

  <section class="intro container" aria-labelledby="intro-title">
    <h2 id="intro-title" class="statement">{t(locale, 'weare')}</h2>
    <p class="statement-sub">{t(locale, 'weare2')}</p>
  </section>
</Base>

<style>
  .hero {
    position: relative;
    min-height: calc(100svh - 4.5rem);
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
  }
  .hero :global(.hero-scene) {
    inset: 0 0 auto 0;
    height: 52%;
  }
  .hero-text {
    position: relative;
    padding-bottom: var(--space-xl);
  }
  h1 {
    font-size: var(--step-5);
    font-weight: 700;
    letter-spacing: -0.05em;
    line-height: 0.92;
    max-width: 10ch;
  }
  .lead {
    margin-top: var(--space-m);
    max-width: 40ch;
    font-size: var(--step-1);
    line-height: 1.45;
    color: var(--mist);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    margin-top: var(--space-l);
  }
  .intro {
    padding-block: var(--space-2xl) var(--space-xl);
  }
  .statement {
    max-width: 20ch;
    font-size: var(--step-4);
    font-weight: 600;
    letter-spacing: -0.04em;
    line-height: 1.02;
  }
  .statement-sub {
    margin-top: var(--space-l);
    max-width: 44ch;
    font-size: var(--step-1);
    line-height: 1.45;
    color: var(--mist);
  }
  @media (min-width: 52rem) {
    .hero :global(.hero-scene) {
      inset: 0 0 0 auto;
      width: 60%;
      height: 100%;
    }
    h1 {
      font-size: clamp(3.4rem, 1.2rem + 6vw, 8rem);
    }
    .intro {
      padding-left: calc(var(--gutter) + (100% - 2 * var(--gutter)) / 3);
    }
  }
</style>
