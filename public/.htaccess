# pegpeg.net on Apache. The site is static (out/ is the document root); only /api/contact.php
# runs PHP. Keeps every address of the previous sites working.

Options -Indexes -MultiViews
DirectoryIndex index.html
DirectorySlash On
ErrorDocument 404 /404.html
AddDefaultCharset utf-8
AddType application/manifest+json webmanifest

<IfModule mod_rewrite.c>
  RewriteEngine On

  # HTTPS, without www
  RewriteCond %{HTTP_HOST} !^localhost [NC]
  RewriteCond %{HTTP_HOST} !^127\. [NC]
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]
  RewriteCond %{HTTP_HOST} !^localhost [NC]
  RewriteCond %{HTTP_HOST} !^127\. [NC]
  RewriteCond %{HTTPS} off
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

  # Never serve dot files or the push-notification keys left on the server by the old site
  RewriteRule (^|/)\. - [F]
  RewriteRule ^apns(/|$) - [F]

  # The bare domain: the visitor's language if we have it, Spanish otherwise
  RewriteCond %{HTTP:Accept-Language} ^ca [NC]
  RewriteRule ^$ /ca/ [R=302,L]
  RewriteCond %{HTTP:Accept-Language} ^en [NC]
  RewriteRule ^$ /en/ [R=302,L]
  RewriteRule ^$ /es/ [R=302,L]

  # Service pages of the previous sites now live in the home page's "What we do" section
  RewriteRule ^es/(servicios|aplicaciones-moviles|aplicaciones-web|soluciones-ia|aplicaciones-iphone-barcelona|desarrollo-aplicaciones)/?$ /es/#services [R=301,NE,L]
  RewriteRule ^en/(services|mobile-apps|web-apps|ai-solutions|iphone-apps-spain|app-development)/?$ /en/#services [R=301,NE,L]
  RewriteRule ^ca/(serveis|aplicacions-mobils|aplicacions-web|solucions-ia|aplicacions-iphone-barcelona|desenvolupament-aplicacions)/?$ /ca/#services [R=301,NE,L]
  # The glossary is gone
  RewriteRule ^(es|en|ca)/(glosario|glossary|glossari)/?$ /$1/ [R=301,L]
  # Entry points of the original PHP site
  RewriteRule ^(index|proyectos|servicios|glosario|contacto|detalle|mobile-apps|web-apps|ai-solutions)\.php$ /es/ [R=301,L]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  # Next's static export inlines its bootstrap scripts; styles inline via style attributes.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; frame-src https://www.youtube-nocookie.com; form-action 'self'; base-uri 'self'; frame-ancestors 'self'; object-src 'none'"

  # Hashed build files never change; pages and data always revalidate
  <If "%{REQUEST_URI} =~ m#^/_next/static/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
  <If "%{REQUEST_URI} =~ m#^/work/#">
    Header set Cache-Control "public, max-age=2592000"
  </If>
  <FilesMatch "\.(html|txt|xml)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>
