---
import Base from '../../layouts/Base.astro';
import WorkCard from '../../components/WorkCard.astro';
import { t, alternatesFor, type Locale, type MessageKey } from '../../i18n';
import { projects, type Category } from '../../data/projects';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const listed = projects.filter((p) => p.listed);
const filters: { value: Category | 'all'; label: MessageKey }[] = [
  { value: 'all', label: 'all' },
  { value: 'app', label: 'apps' },
  { value: 'web', label: 'web' },
  { value: 'game', label: 'games' },
];
const showing = t(locale, 'ui-showing');
---
<Base
  locale={locale}
  title={t(locale, 'meta_projects_title')}
  description={t(locale, 'meta_projects_description')}
  alternates={alternatesFor('projects')}
  current="projects"
>
  <header class="page-head container">
    <h1 data-reveal="lines" data-reveal-now>{t(locale, 'projects')}</h1>
    <p class="lead">{t(locale, 'meta_projects_description')}</p>
  </header>

  <div class="container">
    <div class="filters" role="group" aria-label={t(locale, 'ui-filter-label')}>
      {
        filters.map((f, i) => (
          <button type="button" data-filter={f.value} aria-pressed={i === 0 ? 'true' : 'false'}>
            {t(locale, f.label)}
          </button>
        ))
      }
    </div>
    <p class="visually-hidden" aria-live="polite" data-count data-template={showing}></p>

    <div class="grid">
      {listed.map((project, i) => <WorkCard locale={locale} project={project} eager={i < 3} />)}
    </div>
  </div>
</Base>

<script>
  import { gsap } from 'gsap';
  import { Flip } from 'gsap/Flip';

  gsap.registerPlugin(Flip);

  const grid = document.querySelector<HTMLElement>('.grid')!;
  const cards = [...grid.querySelectorAll<HTMLElement>('.work')];
  const buttons = [...document.querySelectorAll<HTMLButtonElement>('[data-filter]')];
  const count = document.querySelector<HTMLElement>('[data-count]')!;
  const animate = () => document.documentElement.classList.contains('motion');

  function apply(filter: string) {
    const state = animate() ? Flip.getState(cards) : null;
    let shown = 0;
    for (const card of cards) {
      const match = filter === 'all' || card.dataset.categories!.split(' ').includes(filter);
      card.hidden = !match;
      if (match) shown++;
    }
    for (const b of buttons) b.setAttribute('aria-pressed', String(b.dataset.filter === filter));
    count.textContent = count.dataset.template!.replace('{n}', String(shown));

    if (state) {
      Flip.from(state, {
        duration: 0.7,
        ease: 'expo.out',
        absolute: true,
        stagger: 0.025,
        scale: true,
        onEnter: (els) => gsap.fromTo(els, { autoAlpha: 0, scale: 0.92 }, { autoAlpha: 1, scale: 1, duration: 0.6, ease: 'expo.out' }),
        onLeave: (els) => gsap.to(els, { autoAlpha: 0, scale: 0.92, duration: 0.35, ease: 'power2.in' }),
      });
    }
  }

  for (const b of buttons) b.addEventListener('click', () => apply(b.dataset.filter!));
</script>

<style>
  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs);
    padding-bottom: var(--space-l);
  }
  .filters button {
    padding: 0.55rem 1.1rem;
    border: 0;
    border-radius: 999px;
    background: transparent;
    box-shadow: inset 0 0 0 1px var(--line);
    font-weight: 600;
    cursor: pointer;
    transition:
      background-color var(--dur-2) var(--ease-out),
      color var(--dur-2) var(--ease-out),
      box-shadow var(--dur-2) var(--ease-out);
  }
  .filters button:hover {
    box-shadow: inset 0 0 0 1px var(--ink);
  }
  .filters button[aria-pressed='true'] {
    background: var(--ink);
    color: var(--paper);
    box-shadow: none;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 19rem), 1fr));
    gap: var(--space-l) var(--gutter);
  }
  .grid :global(.work[hidden]) {
    display: none;
  }
</style>
