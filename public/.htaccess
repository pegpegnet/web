# pegpeg.net on Apache. The site is static (dist/ is the document root); only
# /api/contact.php runs PHP. Replaces the previous site's routing file.

Options -Indexes -MultiViews
DirectoryIndex index.html
DirectorySlash On
ErrorDocument 404 /404.html
AddDefaultCharset utf-8

<IfModule mod_rewrite.c>
  RewriteEngine On

  # HTTPS, without www
  RewriteCond %{HTTP_HOST} !^localhost [NC]
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]
  RewriteCond %{HTTP_HOST} !^localhost [NC]
  RewriteCond %{HTTPS} off
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

  # Never serve dot files or push-notification keys left on the server by the previous site
  RewriteRule (^|/)\. - [F]
  RewriteRule ^apns(/|$) - [F]

  # Old alias URLs of the previous site, kept alive for links and search results
  RewriteRule ^es/aplicaciones-iphone-barcelona/?$ /es/aplicaciones-moviles/ [R=301,L]
  RewriteRule ^en/iphone-apps-spain/?$ /en/mobile-apps/ [R=301,L]
  RewriteRule ^ca/aplicacions-iphone-barcelona/?$ /ca/aplicacions-mobils/ [R=301,L]
  RewriteRule ^es/desarrollo-aplicaciones/?$ /es/aplicaciones-web/ [R=301,L]
  RewriteRule ^en/app-development/?$ /en/web-apps/ [R=301,L]
  RewriteRule ^ca/desenvolupament-aplicacions/?$ /ca/aplicacions-web/ [R=301,L]
  RewriteRule ^(index|proyectos|servicios|glosario|contacto|detalle|mobile-apps|web-apps|ai-solutions)\.php$ /es/ [R=301,L]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  # Inline scripts: the motion flag in <head> and small bundles Astro inlines. Styles: view-transition-name attributes.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-src https://www.youtube-nocookie.com; form-action 'self'; base-uri 'self'; frame-ancestors 'self'; object-src 'none'"

  # Hashed build assets never change; pages always revalidate
  <If "%{REQUEST_URI} =~ m#^/_astro/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
  <FilesMatch "\.(html|xml|txt)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>
