---
import Base from '../../layouts/Base.astro';
import Section from '../../components/Section.astro';
import { t, alternatesFor, type Locale, type MessageKey } from '../../i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const ios: MessageKey[] = ['mobileapps-ios-swift', 'mobileapps-ios-swiftui', 'mobileapps-ios-design', 'mobileapps-ios-performance', 'mobileapps-ios-appstore'];
const android: MessageKey[] = ['mobileapps-android-kotlin', 'mobileapps-android-material', 'mobileapps-android-features', 'mobileapps-android-performance', 'mobileapps-android-playstore'];
const process: MessageKey[] = ['mobileapps-process-planning', 'mobileapps-process-design', 'mobileapps-process-development', 'mobileapps-process-deployment', 'mobileapps-process-support'];
const qa: MessageKey[] = ['mobileapps-qa-testing', 'mobileapps-qa-performance', 'mobileapps-qa-security', 'mobileapps-qa-compatibility', 'mobileapps-qa-ux'];
---
<Base
  locale={locale}
  title={t(locale, 'meta_mobile_apps_title')}
  description={t(locale, 'meta_mobile_apps_description')}
  alternates={alternatesFor('mobileApps')}
  current="services"
>
  <header class="page-head container">
    <h1>{t(locale, 'mobileapps-title')}</h1>
    <p class="lead">{t(locale, 'mobileapps-description-1')}</p>
  </header>

  <Section title={t(locale, 'mobileapps-native-title')} id="native">
    <p>{t(locale, 'mobileapps-description-2')}</p>
    <p set:html={t(locale, 'mobileapps-description-3')} />
  </Section>

  <Section title={t(locale, 'mobileapps-ios-title')} id="ios">
    <p>{t(locale, 'mobileapps-ios-desc')}</p>
    <ul>{ios.map((k) => <li>{t(locale, k)}</li>)}</ul>
  </Section>

  <Section title={t(locale, 'mobileapps-android-title')} id="android">
    <p>{t(locale, 'mobileapps-android-desc')}</p>
    <ul>{android.map((k) => <li>{t(locale, k)}</li>)}</ul>
  </Section>

  <Section title={t(locale, 'mobileapps-process-title')} id="process">
    <p>{t(locale, 'mobileapps-process-desc')}</p>
    <ol>{process.map((k) => <li>{t(locale, k)}</li>)}</ol>
  </Section>

  <Section title={t(locale, 'mobileapps-qa-title')} id="qa">
    <p>{t(locale, 'mobileapps-qa-desc')}</p>
    <ul>{qa.map((k) => <li>{t(locale, k)}</li>)}</ul>
  </Section>
</Base>
